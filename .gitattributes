# 줄바꿈은 저장소 안에서 LF 로 통일합니다. 체크아웃은 각 OS 기본을 따릅니다.
* text=auto

# 컨테이너 안(리눅스)에서 실행되거나 리눅스 도구가 읽는 파일은 LF 로 고정합니다.
*.sh        text eol=lf
gradlew     text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf

# 윈도우 배치 파일은 CRLF 여야 합니다.
*.bat       text eol=crlf

# 바이너리로 다뤄 diff/병합을 시도하지 않게 합니다.
*.jar       binary
*.png       binary
*.npz       binary
*.pkl       binary
*.pth       binary
